# ============================================================
# LLM API Keys / LLM API 密钥
# ============================================================

# OpenAI API Key (used for Embedding, Rerank, and Wiki Ingest)
# OpenAI API Key（用于 Embedding、Rerank、Wiki 摄入）
OPENAI_API_KEY=""

# DashScope API Key (used for LLM answer generation, optional)
# DashScope API Key（用于 LLM 答案生成，可选）
DASHSCOPE_API_KEY=""

# MiniCPM-V API Key (used for multimodal image understanding, optional)
# MiniCPM-V API Key（用于多模态图像理解，可选）
MINICPM_API_KEY=""


# ============================================================
# Milvus Vector Database / Milvus 向量数据库
# ============================================================

# Milvus connection URI
# Milvus 连接地址
MILVUS_URI="http://localhost:19530"

# Milvus database name
# Milvus 数据库名
MILVUS_DB_NAME="default"


# ============================================================
# Service URLs / 服务地址
# ============================================================

# Dense embedding service URL (OpenAI-compatible)
# 稠密 Embedding 服务地址（OpenAI-compatible）
EMBEDDING_URL="http://localhost:8001/v1"

# Sparse embedding service URL (BM42, OpenAI-compatible)
# 稀疏 Embedding 服务地址（BM42，OpenAI-compatible）
SPARSE_EMBEDDING_URL="http://localhost:8002/v1"

# Reranker service URL (OpenAI-compatible)
# Reranker 服务地址（OpenAI-compatible）
RERANK_URL="http://localhost:8003/v1"

# LLM generation service URL (OpenAI-compatible)
# LLM 生成服务地址（OpenAI-compatible）
LLM_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# RAG retrieval service URL (used by api_gateway.py)
# RAG 检索服务地址（api_gateway.py 调用）
RAG_URL="http://127.0.0.1:17101"

# Wiki-enhanced retrieval service URL (used by api_gateway.py)
# Wiki 增强检索服务地址（api_gateway.py 调用）
WIKI_URL="http://127.0.0.1:17101"

# MiniCPM-V multimodal service URL
# MiniCPM-V 多模态服务地址
MINICPM_API_URL="http://localhost:8008/v1"


# ============================================================
# Model Settings / 模型配置
# ============================================================

# Default LLM model name
# 默认 LLM 模型名
LLM_MODEL="qwen3-max"

# Default embedding model name
# 默认 Embedding 模型名
EMBEDDING_MODEL="bge-m3"

# Default reranker model name
# 默认 Reranker 模型名
RERANK_MODEL="bge-reranker-v2-m3"

# MiniCPM-V model name
# MiniCPM-V 模型名
MINICPM_MODEL="openbmb/MiniCPM-V-4.6"

# MiniCPM-V request timeout (seconds)
# MiniCPM-V 请求超时（秒）
MINICPM_TIMEOUT=30

# OpenAI-compatible API timeout (seconds)
# OpenAI-compatible API 超时（秒）
OPENAI_TIMEOUT=30.0

# OpenAI-compatible API max retries
# OpenAI-compatible API 最大重试次数
OPENAI_MAX_RETRIES=5

# Knowledge Base UUID for Wiki ingest (required when building KB)
# Wiki 知识库 UUID（构建知识库时必填）
KB_BUILD_KNOWLEDGE_UUID=""


# ============================================================
# Cache Paths / 缓存路径
# ============================================================

FASTEMBED_CACHE_PATH="retriever/models"
JIEBA_CACHE_FOLDER="retriever/models/"
TIKTOKEN_CACHE_DIR="retriever/models/"


# ============================================================
# Optional: GPU Settings / 可选：GPU 设置
# ============================================================

# CUDA device index, -1 for CPU
# CUDA 设备索引，-1 表示使用 CPU
CUDA_VISIBLE_DEVICES=-1
